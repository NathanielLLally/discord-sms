# An example configuration for vdirsyncer.
#
# Move it to ~/.vdirsyncer/config or ~/.config/vdirsyncer/config and edit it.
# Run `vdirsyncer --help` for CLI usage.
#
# Optional parameters are commented out.
# This file doesn't document all available parameters, see
# http://vdirsyncer.pimutils.org/ for the rest of them.

[general]
# A folder where vdirsyncer can store some metadata about each pair.
status_path = "~/.vdirsyncer/status/"

[pair google_contacts]
# A `[pair <name>]` block defines two storages `a` and `b` that should be
# synchronized. The definition of these storages follows in `[storage <name>]`
# blocks. This is similar to accounts in OfflineIMAP.
a = "google_contacts_local"
b = "google_contacts_remote"
collections = ["from b"]
conflict_resolution = "b wins"

# CARDDAV
[pair icloud_contacts]
# A `[pair <name>]` block defines two storages `a` and `b` that should be
# synchronized. The definition of these storages follows in `[storage <name>]`
# blocks. This is similar to accounts in OfflineIMAP.
a = "icloud_contacts_local"
b = "icloud_contacts_remote"

# Synchronize all collections that can be found.
# You need to run `vdirsyncer discover` if new calendars/addressbooks are added
# on the server.
#collections = [["icloud_contacts", "icloud_contacts"]]
#collections = ["from a", "from b"]
collections = ["card"]

# Synchronize the "display name" property into a local file (~/.icloud_contacts/displayname).
metadata = ["displayname"]

# To resolve a conflict the following values are possible:
#   `null` - abort when collisions occur (default)
#   `"a wins"` - assume a's items to be more up-to-date
#   `"b wins"` - assume b's items to be more up-to-date
#conflict_resolution = null

[storage icloud_contacts_local]
# A storage references actual data on a remote server or on the local disk.
# Similar to repositories in OfflineIMAP.
type = "filesystem"
path = "~/.contacts/icloud"
fileext = ".vcf"

[storage icloud_contacts_remote]
type = "carddav"
url = "https://contacts.icloud.com/"
username.fetch = ["command", "printenv", "APPLE_CONTACTS_USER"]
# The password can also be fetched from the system password storage, netrc or a
# custom command. See http://vdirsyncer.pimutils.org/en/stable/keyring.html
#password = "xnfl-iiem-wcwu-kytu"
password.fetch = ["command", "printenv", "APPLE_CONTACTS_PASS"]


[storage google_contacts_local]
# A storage references actual data on a remote server or on the local disk.
# Similar to repositories in OfflineIMAP.
type = "filesystem"
path = "~/.contacts/google"
fileext = ".vcf"

[storage google_contacts_remote]
type = "google_contacts"
token_file = "~/.vdirsyncer/google_token"
client_id = "YOUR_CLIENT_ID"
client_id.fetch = ["command", "printenv", "GOOGLE_CONTACTS_CLIENTID"]
client_secret = "YOUR_CLIENT_SECRET"
client_secret.fetch = ["command", "printenv", "GOOGLE_CONTACTS_SECRET"]

