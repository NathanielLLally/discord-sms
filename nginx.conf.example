# Reverse proxy for the Twilio webhook receiver.
# The bot listens on 127.0.0.1:DISCORD_WEBHOOK_PORT (default 2324).
# Point your Twilio number's "A MESSAGE COMES IN" webhook at:
#     https://sms.example.com/sms   (HTTP POST)

server {
    listen 443 ssl;
    server_name sms.example.com;

    ssl_certificate     /etc/letsencrypt/live/sms.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sms.example.com/privkey.pem;

    location /sms {
        proxy_pass         http://127.0.0.1:2324/sms;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
