# Reverse proxy for the Twilio webhook receiver.
# The bot listens on 127.0.0.1:DISCORD_WEBHOOK_PORT (default 2324).
# Point your Twilio number's "A MESSAGE COMES IN" webhook at:
#     https://sms.example.com/sms   (HTTP POST)

server {
    listen 443 ssl;
    server_name sms.example.com;

    ssl_certificate     /etc/letsencrypt/live/sms.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sms.example.com/privkey.pem;

    location /sms {
        proxy_pass         http://127.0.0.1:2324/sms;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /media/ {
        proxy_pass         http://127.0.0.1:2324/media/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}

# Twilio call status callbacks -> second listener (TWILIO_STATUS_PORT, default 2325).
# Set the number's / call's "Call status changes" StatusCallback URL to:
#     https://status.twilio.happytailspawcare.com/   (HTTP POST)
server {
    listen 443 ssl;
    server_name status.twilio.happytailspawcare.com;

    ssl_certificate     /etc/letsencrypt/live/status.twilio.happytailspawcare.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/status.twilio.happytailspawcare.com/privkey.pem;

    location / {
        proxy_pass         http://127.0.0.1:2325;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}

# Vapi server/status webhooks -> third listener (VAPI_STATUS_PORT, default 2326).
# Set the Vapi Server URL to:
#     https://status.vapi.crm.happytailspawcare.com/   (HMAC credential, VAPI_HMAC_PSK)
server {
    listen 443 ssl;
    server_name status.vapi.crm.happytailspawcare.com;

    ssl_certificate     /etc/letsencrypt/live/status.vapi.crm.happytailspawcare.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/status.vapi.crm.happytailspawcare.com/privkey.pem;

    location / {
        proxy_pass         http://127.0.0.1:2326;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
